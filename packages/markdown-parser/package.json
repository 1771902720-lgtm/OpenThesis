{
  "name": "@openthesis/markdown-parser",
  "version": "0.2.0",
  "description": "Convert Markdown manuscripts into typed OpenThesis thesis, journal, or official-document JSON",
  "keywords": ["markdown", "docx", "thesis", "journal", "official-document", "parser"],
  "repository": { "type": "git", "url": "https://github.com/1771902720-lgtm/OpenThesis.git", "directory": "packages/markdown-parser" },
  "homepage": "https://github.com/1771902720-lgtm/OpenThesis#readme",
  "license": "MIT",
  "author": "OpenThesis Contributors",
  "publishConfig": { "access": "public" },
  "files": ["dist", "src", "README.md"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
