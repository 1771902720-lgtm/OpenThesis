{
  "name": "openthesis",
  "version": "0.2.0",
  "private": true,
  "description": "AI-powered Document Template Engine — Parse any .docx template, write structured JSON, export submission-ready DOCX. Supports thesis, journal articles, and official documents.",
  "keywords": [
    "docx",
    "template",
    "thesis",
    "academic",
    "journal",
    "official-document",
    "word",
    "office",
    "typescript",
    "cli",
    "document-generator",
    "template-engine",
    "university",
    "paper"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Gluxggg/OpenThesis.git"
  },
  "homepage": "https://github.com/Gluxggg/OpenThesis#readme",
  "bugs": {
    "url": "https://github.com/Gluxggg/OpenThesis/issues"
  },
  "author": "OpenThesis Contributors",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "clean": "pnpm -r clean",
    "cli": "node packages/cli/dist/index.js",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm build && pnpm test"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.6.0",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jszip": "^3.10.1"
  }
}
